VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Firebase Web app configuration (client-side values; restrict the API key by referrer in Google Cloud)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match the administrator UID hardcoded in firestore.rules and storage.rules
VITE_FIREBASE_ADMIN_UID=
VITE_FIREBASE_ADMIN_EMAIL=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=your_publishable_key
