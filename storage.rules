rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'uROTP7r3rgZUcmLn9MSQmrtGNFh1';
    }

    function imageUpload(maxBytes) {
      return isAdmin()
        && request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType in ['image/jpeg', 'image/png'];
    }

    function pdfUpload(maxBytes) {
      return isAdmin()
        && request.resource != null
        && request.resource.size < maxBytes
        && request.resource.contentType == 'application/pdf';
    }

    function portfolioAssetUpload() {
      return isAdmin()
        && request.resource != null
        && (
          (
            request.resource.contentType == 'application/pdf'
            && request.resource.size < 15 * 1024 * 1024
          )
          || (
            request.resource.contentType in ['image/jpeg', 'image/png']
            && request.resource.size < 10 * 1024 * 1024
          )
        );
    }

    match /profile/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if imageUpload(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /projects/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if imageUpload(10 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /resume/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if pdfUpload(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /certifications/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if portfolioAssetUpload();
      allow delete: if isAdmin();
    }

    match /achievements/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if portfolioAssetUpload();
      allow delete: if isAdmin();
    }

    match /internships/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if portfolioAssetUpload();
      allow delete: if isAdmin();
    }

    match /workshops/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if portfolioAssetUpload();
      allow delete: if isAdmin();
    }

    match /publications/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if pdfUpload(15 * 1024 * 1024);
      allow delete: if isAdmin();
    }

    match /certificates/{filePath=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource != null
        && (
          (
            request.resource.contentType == 'application/pdf'
            && request.resource.size < 15 * 1024 * 1024
          )
          || (
            request.resource.contentType in ['image/jpeg', 'image/png']
            && request.resource.size < 10 * 1024 * 1024
          )
        );
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
